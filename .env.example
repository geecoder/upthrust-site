# ============================================================
# ANALYTICS (Mixpanel)
# ============================================================
# The browser token is public-facing by design. No service-account secret
# belongs in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Data residency. Set the host explicitly:
#   US  https://api-js.mixpanel.com   (default)
#   EU  https://api-eu.mixpanel.com
#   IN  https://api-in.mixpanel.com
NEXT_PUBLIC_MIXPANEL_API_HOST=

# Legacy shorthand, still honoured when API_HOST is unset: US | EU | IN
NEXT_PUBLIC_MIXPANEL_RESIDENCY=US

# Server-side ingestion for Enrolment Completed / Payment Failed. Optional —
# falls back to NEXT_PUBLIC_MIXPANEL_TOKEN, which is the same project token.
# Set these to keep the value out of the client bundle entirely.
MIXPANEL_TOKEN=
MIXPANEL_API_HOST=

# Enrolment persistence — an Upstash Redis database (or Vercel's Redis
# marketplace integration, which injects KV_REST_API_URL/TOKEN instead).
# Required for the enrol flow's bank-transfer rail to work at all: without
# it, /api/enrol/init returns 503. See lib/kv.ts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret for the internal-only bank-transfer reconciliation route
# (app/api/enrol/mark-transfer-confirmed) — an ops person passes this in an
# x-ops-token header after matching a bank statement to a reference.
INTERNAL_OPS_TOKEN=

# Paystack (Nigeria rail) — the checkout UI is fully built (see
# lib/payments/paystack.ts) but every call requires this secret key at
# runtime. Without it, /api/enrol/init returns a clear 503 for NG rather than
# a fake success. Also set this in your Paystack dashboard's webhook config,
# pointed at /api/enrol/paystack-webhook, to confirm payments in real time
# (the checkout-return page also does a live verify as a fallback).
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Resend (enrolment confirmation email) — not yet wired up.
RESEND_API_KEY=

# ============================================================
# BANK ACCOUNTS — payee details for the bank-transfer rails.
# Read only by lib/payments/bank-accounts.ts (marked `server-only`), and
# rendered per visitor region by the pathway page's server component. Never
# put real values in this file — it is committed. Put them in .env.local.
# A region with any required field missing renders as "details on request"
# instead of a half-filled account block.
# ============================================================
BANK_PAYEE_NAME=
BANK_GBP_BANK=
BANK_GBP_ACCOUNT=
BANK_GBP_SORT=
BANK_GBP_IBAN=
BANK_GBP_SWIFT=
BANK_USD_BANK=
BANK_USD_ACCOUNT=
BANK_USD_ROUTING=
BANK_USD_TYPE=
BANK_USD_SWIFT=
BANK_CAD_BANK=
BANK_CAD_ACCOUNT=
BANK_CAD_INSTITUTION=
BANK_CAD_TRANSIT=
BANK_CAD_SWIFT=
BANK_NGN_BANK=
BANK_NGN_ACCOUNT=
BANK_NGN_TYPE=
PAYMENT_PROOF_EMAIL=
